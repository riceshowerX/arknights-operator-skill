# 统一换行符与文本判定
# 目的：避免 Windows 贡献者提交后整文件 diff（CRLF vs LF）
* text=auto eol=lf

# 代码与文档按文本处理
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.in    text eol=lf
*.cfg   text eol=lf
*.mermaid text eol=lf

# Windows 脚本保留 CRLF（如果以后加入）
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.whl   binary
*.zip   binary
*.gz    binary

# 避免 GitHub 语言统计把样例数据算进去
operators/**/*.json  linguist-vendored
tools/_data/*.json   linguist-vendored
tests/**/*.json      linguist-vendored
