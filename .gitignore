# ── 虚拟环境 ────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── 测试与覆盖率 ────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── 静态检查与类型缓存 ──────────────────────────
.ruff_cache/
