*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.installed.cfg

# ── 构建产物 ────────────────────────────────────
build/
dist/
sdist/
wheels/
develop-eggs/
.eggs/
lib/
lib64/
parts/
var/
downloads/
